{
  "ConnectionStrings": {
    "Default": "Data Source=:memory:;"
  },
  "Database": {
    "AutoMigrate": true,
    "SeedData": false
  },
  "Api": {
    "BaseUrl": "http://localhost:5124/",
    "EnableSwagger": true,
    "AllowedOrigins": ["http://localhost:5174", "https://localhost:5175"]
  },
  "Jwt": {
    "Key": "TestKeyThatIsAtLeast32CharactersLongForTesting",
    "Issuer": "FitQuestTestIssuer",
    "Audience": "FitQuestTestAudience"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "FitQuest": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
