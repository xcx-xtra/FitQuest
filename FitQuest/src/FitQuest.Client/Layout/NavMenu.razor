@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 d-flex justify-content-between align-items-center">
    <a class="navbar-brand" href="">FitQuest</a>
    <button title="Navigation menu" class="navbar-toggler d-md-none" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="d-flex flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <a href="/dashboard" class="nav-link">Dashboard</a>
                </div>
                <div class="nav-item">
                    <a @onclick="Logout" class="nav-link" style="cursor: pointer;">Logout</a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <a href="/login" class="nav-link">Login</a>
                </div>
                <div class="nav-item">
                    <a href="/register" class="nav-link">Register</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@if (isAdmin)
{
    <div class="nav-item">
        <NavLink class="nav-link" href="/admin" Match="NavLinkMatch.All">
            <span class="oi oi-dashboard" aria-hidden="true"></span> Admin
        </NavLink>
    </div>
}

@code {
    private bool collapseNavMenu = true;
    private bool isAdmin;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    [Inject] public required IJSRuntime JS { get; set; } = default!;
    [Inject] public required NavigationManager Nav { get; set; } = default!;
    @inject AuthenticationStateProvider AuthenticationStateProvider

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Nav.NavigateTo("/login", forceLoad: true);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
    }
}
