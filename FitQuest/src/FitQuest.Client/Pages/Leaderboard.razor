@page "/leaderboard"
@inject HttpClient Http
@inject LeaderboardService LeaderboardService

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-body">
                    <h1 class="card-title fs-2 fw-bold mb-4">Leaderboard</h1>
                    @if (leaders == null)
                    {
                        <div class="text-center">
                            <p class="text-muted">Loading leaderboard...</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="text-uppercase fw-semibold text-muted fs-6">User</th>
                                        <th scope="col" class="text-uppercase fw-semibold text-muted fs-6">Points</th>
                                        <th scope="col" class="text-uppercase fw-semibold text-muted fs-6">Badges</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (leaders != null)
                                    {
                                        foreach (var user in leaders)
                                        {
                                            <tr>
                                                <td class="fw-medium">@user.UserId</td>
                                                <td class="fw-semibold text-success">@user.TotalPoints</td>
                                                <td><i class="fas fa-star text-warning"></i></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<UserScoreDto>? leaders;

    protected override async Task OnInitializedAsync()
    {
        LeaderboardService.OnLeaderboardUpdated += async () =>
        {
            await LoadLeaderboard();
            StateHasChanged();
        };

        await LeaderboardService.ConnectAsync();
        await LoadLeaderboard();
    }

    private async Task LoadLeaderboard()
    {
        leaders = await Http.GetFromJsonAsync<List<UserScoreDto>>("/api/leaderboard/top");
    }

    public class UserScoreDto
    {
        public string UserId { get; set; } = "";
        public int TotalPoints { get; set; }
    }
}