@page "/test-component"

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <h3 class="card-title mb-4">Test Component</h3>
                    <button @onclick="EventCallback.Factory.Create(this, TestMethod)" class="btn btn-primary">Click Me</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void TestMethod()
    {
        Console.WriteLine("Button clicked!");
    }
}