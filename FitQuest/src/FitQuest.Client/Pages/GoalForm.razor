@page "/goal"
@inject GoalService GoalService
@using FitQuest.Shared.Models

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title mb-4">Set Daily Goal</h3>

                    <EditForm Model="@goal" OnValidSubmit="SubmitGoal">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="form-group">
                            <label class="form-label">Title:</label>
                            <InputText @bind-Value="goal.Title" class="form-control" placeholder="Enter goal title" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Description:</label>
                            <InputTextArea @bind-Value="goal.Description" class="form-control" placeholder="Enter goal description" rows="3" />
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox @bind-Value="goal.IsCompleted" class="form-check-input" />
                            <label class="form-check-label">Completed?</label>
                        </div>

                        <button type="submit" class="btn btn-primary">Save Goal</button>

                        @if (success != null)
                        {
                            <div class="mt-3">
                                <p class="text-success mb-0">@success</p>
                            </div>
                        }
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DailyGoal goal = new();
    private string? success;

    private async Task SubmitGoal()
    {
        var result = await GoalService.SubmitGoalAsync(goal);
        success = result ? "Goal saved!" : "Something went wrong.";
    }
}