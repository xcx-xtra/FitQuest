{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.AspNetCore.Authorization": "Debug",
        "FitQuest": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fitquest-dev-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "ConnectionStrings": {
    "Default": "Data Source=FitQuestDb.sqlite;"
  },
  "Database": {
    "AutoMigrate": true,
    "SeedData": true
  },
  "Api": {
    "BaseUrl": "http://localhost:5124/",
    "EnableSwagger": true,
    "AllowedOrigins": ["http://localhost:5174", "https://localhost:5175"]
  },
  "Jwt": {
    "Key": "YourSuperSecureKeyThatIsAtLeast32CharactersLong",
    "Issuer": "FitQuestIssuer",
    "Audience": "FitQuestAudience"
  }
}
